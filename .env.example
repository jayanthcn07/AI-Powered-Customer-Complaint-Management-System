# This project uses two separate .env files (one per service), because the
# backend and frontend are deployed/run independently:
#
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env
#
# This root file is a quick-reference summary of every variable used across
# the whole app. Fill in real values only in the service-level .env files
# below - never commit real secrets.

# ============ backend/.env ============
DATABASE_URL=sqlite:///./complaints.db
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=gemma2-9b-it
GROQ_CONTEXT_MODEL=llama-3.3-70b-versatile
APP_NAME=AI-Powered Customer Complaint Management System
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ frontend/.env ============
VITE_API_BASE_URL=http://localhost:8000
